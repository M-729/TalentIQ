# Server
NODE_ENV=development
PORT=4000

# MongoDB (Atlas)
# Get this from Atlas: Database > Connect > Drivers > Node.js.
# Replace <user>/<password>/<cluster-host>, and keep a distinct database
# name per environment (e.g. talentiq_dev, talentiq_prod) within the same
# cluster so environments never share data.
# NEVER put real credentials in this file — it is committed to git.
# Real values go only in your local .env, which is gitignored.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database-name>

# CORS
CORS_ORIGIN=http://localhost:5173

# JWT access token
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Cloudflare R2 (CV storage) — get these from the Cloudflare dashboard:
# R2 > Manage API Tokens (for the access key pair) and R2 > Overview (for
# your account id and the bucket you create there). No endpoint/region
# variable is needed — the R2 endpoint is derived from R2_ACCOUNT_ID.
# Optional: the backend runs fine without these (including the full test
# suite, which mocks CV storage entirely); only actual CV upload requires
# them to be set in your local .env.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# SMTP (candidate confirmation emails) — get these from your email
# provider (e.g. a transactional email service, or your own mail server).
# SMTP_PASS is a real secret — never fill this in here, only in your local
# .env, which is gitignored.
# Optional: the backend runs fine without these (including the full test
# suite, which mocks the email service entirely); only actually sending a
# confirmation email requires them to be set in your local .env.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=TalentIQ
EMAIL_FROM_ADDRESS=

# Groq (AI screening foundation) — get an API key from console.groq.com.
# GROQ_API_KEY is a real secret — never fill this in here, only in your
# local .env, which is gitignored.
# Optional: the backend runs fine without these (including the full test
# suite, which mocks the AI service entirely); only actually calling the
# AI service requires GROQ_API_KEY to be set in your local .env.
# GROQ_MODEL has a working default and only needs overriding to change
# which Groq-hosted model is used.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# AI screening rate limit — caps how many new (paid) AI screenings one
# authenticated HR/Admin user can trigger per hour via POST
# /api/v1/applications/:applicationId/screenings. Not a secret; safe to
# keep a real default here. Only the "run a new screening" route is
# limited — viewing latest/history screenings is unaffected.
AI_SCREENING_RATE_LIMIT_PER_HOUR=20

# How long (minutes) an initial AI screening may sit "processing" before
# it's treated as stale/interrupted (e.g. a backend crash mid-screening)
# and becomes safely retryable. Not a secret. 15 is a sensible default —
# a real screening normally finishes in seconds.
AI_SCREENING_PROCESSING_TIMEOUT_MINUTES=15

# Google Calendar/Meet interview integration — see
# docs/google-calendar-setup.md for how to create these in Google Cloud
# Console. GOOGLE_CLIENT_SECRET and GOOGLE_TOKEN_ENCRYPTION_KEY are real
# secrets — never fill them in here, only in your local .env, which is
# gitignored.
# Optional: the backend runs fine without these (including the full test
# suite, which mocks the Google provider entirely); only actually
# connecting a Google account or creating/syncing a Calendar event
# requires them to be set in your local .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google-calendar/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# The externally reachable origin of the TalentIQ frontend. Not a secret;
# safe to keep a real default here. Used both for where the Google OAuth
# callback redirects the browser after success/failure, and to build the
# candidate-facing Offer Accept/Decline links sent in offer emails. Must be
# http:// or https:// (no trailing slash needed — one is stripped
# automatically if present).
#
# Local development (default): http://localhost:5173
#   This only works when the candidate opens the email on THIS SAME
#   machine — "localhost" always means the device opening the link, never
#   your dev machine. To let a candidate test Accept/Decline from another
#   device during local development, set this to an explicitly configured,
#   externally reachable URL instead (e.g. a tunnel like ngrok, or a
#   deployed preview URL). TalentIQ never auto-discovers your LAN IP or
#   otherwise exposes your dev machine on its own.
#
# Staging/production: the real deployed frontend origin, e.g.
#   https://talentiq.example.com
FRONTEND_URL=http://localhost:5173
