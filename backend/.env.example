# Server
NODE_ENV=development
PORT=4000

# MongoDB (Atlas)
# Get this from Atlas: Database > Connect > Drivers > Node.js.
# Replace <user>/<password>/<cluster-host>, and keep a distinct database
# name per environment (e.g. talentiq_dev, talentiq_prod) within the same
# cluster so environments never share data.
# NEVER put real credentials in this file — it is committed to git.
# Real values go only in your local .env, which is gitignored.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database-name>

# CORS
CORS_ORIGIN=http://localhost:5173

# JWT access token
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Password hashing
BCRYPT_SALT_ROUNDS=12
